{
  "manifest_version": 3,
  "name": "Rana by Exzellent",
  "version": "0.1.1",
  "description": "Rana, the Exzellent companion: tips from your own dashboard (next lesson, homework, streak) while the buddy there is minimized.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://exzellent-backend-1.onrender.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.exzellent.co/*"],
      "js": ["vendor/exzi-character.js", "lib/common.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Rana",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
